! Instructions for compiling revised verb model for Plains Cree
! Output as HFST

read lexc lexicon_weighted.lexc ! Weighted version
save stack fst/lexicon.hfst
define Morph

source phonology/phonology.xfscript
define Phon

source phonology/derivation-phonology.xfscript
define DrvPhon

source orthography/spellrelax_weighted.xfscript
define SpellRelax

define yLemmaNorm [ y <- "ý" ];
define Bx [ "<" | ">" | "/" ];
define rmBx [ Bx -> 0 ];

define MorphWeight [ "/" -> "/"::10.0 ];

define ErrTags [ "+Err/Morph" | "+Err/Orth" | "+Err/Dim" | "+Err/Thm" ];
define ErrFilter ~$[ ErrTags ];

set flag-is-epsilon ON

! Normative FST without morpheme boundaries

define FSTdictnorm [ ErrFilter .o. Morph .o. DrvPhon .o. Phon .o. rmBx ];
push FSTdictnorm
invert net
save stack fst/analyser-gt-dict-norm.hfst
invert net
save stack fst/generator-gt-dict-norm.hfst
clear stack

define FSTnorm [ yLemmaNorm .o. FSTdictnorm .o. yLemmaNorm.i ];
! define FSTnorm [ ErrFilter .o. yLemmaNorm .o. Morph .o. DrvPhon .o. Phon .o. rmBx ]; ! Normalization of accented <ý> on analysis side
! define FSTnorm [ ErrFilter .o. yLemmaNorm .o. Morph .o. DrvPhon .o. Phon .o. MorphWeight .o. rmBx ]; ! Default weighting
push FSTnorm
invert net
save stack fst/analyser-gt-norm.hfst
invert net
save stack fst/generator-gt-norm.hfst
clear stack

! Normative generator FST with morpheme boundaries in surface forms

define FSTdictbound [ Morph .o. DrvPhon .o. Phon ].i;
push FSTdictbound
invert net
save stack fst/generator-gt-dict-norm-bound.hfst
clear stack

! define FSTbound [ yLemmaNorm .o. Morph .o. DrvPhon .o. Phon ].i; ! Normalization of accented <ý> on analysis side
! define FSTbound [ yLemmaNorm .o. Morph .o. DrvPhon .o. Phon .o. MorphWeight ].i;
define FSTbound [ yLemmaNorm .o. FSTdictbound.i .o. yLemmaNorm.i ].i;
push FSTbound
invert net
save stack fst/generator-gt-norm-bound.hfst
clear stack

! Descriptive analyzer FST with spell-relaxation rules (without morpheme

define FSTdictdesc [ FSTdictbound.i .o. rmBx .o. SpellRelax ];
push FSTdictdesc
invert net
save stack fst/analyser-gt-dict-desc.hfst

! define FSTdesc [ yLemmaNorm .o. Morph .o. DrvPhon .o. Phon .o. MorphWeight .o. rmBx .o. SpellRelax ];
! define FSTdesc [ yLemmaNorm .o. Morph .o. DrvPhon .o. Phon .o. rmBx .o. SpellRelax ];
! define FSTdesc [ yLemmaNorm .o. FSTdictbound.i .o. rmBx .o. SpellRelax ];
define FSTdesc [ yLemmaNorm .o. FSTdictdesc ];
push FSTdesc
invert net
save stack fst/analyser-gt-desc.hfst
